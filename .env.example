POSTGRES_DB=gamercalendar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/gamercalendar

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Steam Web API key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# URL the device/Custom Tab can reach for OpenID return_to (emulator: http://10.0.2.2:8000)
PUBLIC_BASE_URL=http://10.0.2.2:8000
STEAM_DEEP_LINK_SUCCESS=gamercalendar://steam/linked
STEAM_DEEP_LINK_ERROR=gamercalendar://steam/error
